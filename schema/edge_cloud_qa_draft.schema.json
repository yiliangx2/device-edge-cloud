{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge_qa_final_700_v2.schema.json",
  "title": "端边云最终700条问答对 Schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "分支",
    "问题",
    "问题类型",
    "任务特征",
    "资源状态",
    "QoS目标",
    "资源侧约束",
    "决策目标",
    "为什么不能固定部署",
    "执行方案",
    "协同策略",
    "适合算法",
    "最优算法",
    "超参数设定",
    "参数依据",
    "反馈调整建议",
    "推理"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^edge_(agv|sched|offload|vision|dt|ar|sensor)_[0-9]{4}$"
    },
    "分支": {
      "const": "edge_cloud"
    },
    "问题": {
      "type": "string",
      "minLength": 220,
      "not": {
        "const": "待LLM生成"
      }
    },
    "问题类型": {
      "enum": [
        "多AGV路径规划",
        "产线调度",
        "任务卸载/资源配置",
        "机器视觉质检",
        "预测性维护/数字孪生",
        "AR远程运维",
        "工业传感与异常检测"
      ]
    },
    "任务特征": {
      "type": "object"
    },
    "资源状态": {
      "type": "object"
    },
    "QoS目标": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3
    },
    "资源侧约束": {
      "type": "array",
      "minItems": 1
    },
    "决策目标": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/target"
        },
        "secondary": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "协同策略": {
      "enum": [
        "local_execution",
        "edge_offloading",
        "cloud_offloading",
        "device_edge_collaboration",
        "edge_cloud_collaboration",
        "hierarchical_collaboration",
        "fallback_safe_local",
        "defer_or_reject"
      ]
    },
    "为什么不能固定部署": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "执行方案": {
      "type": "object"
    },
    "适合算法": {
      "type": "object"
    },
    "最优算法": {
      "type": [
        "string",
        "null"
      ]
    },
    "超参数设定": {
      "$ref": "#/$defs/parameter_config"
    },
    "参数依据": {
      "$ref": "#/$defs/parameter_rationale"
    },
    "反馈调整建议": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feedback_item"
      }
    },
    "推理": {
      "type": "string",
      "minLength": 20,
      "maxLength": 260
    },
    "无法执行原因": {
      "$ref": "#/$defs/unavailable_reason"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "decision_role"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_role": {
          "enum": [
            "task_side",
            "resource_side",
            "communication_data_side",
            "model_inference_side",
            "joint"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "推荐理由"
      ],
      "properties": {
        "algorithm_id": {
          "type": "string",
          "enum": [
            "abc",
            "aco",
            "admm",
            "agemoea2",
            "astar",
            "autoencoder_anomaly",
            "b&b",
            "bola",
            "cbs",
            "cp_sat",
            "cusum",
            "de",
            "dqn",
            "dynamic_batching",
            "edgent",
            "eecbs",
            "fedavg",
            "g&t",
            "ga",
            "ha",
            "ils",
            "isolation_forest",
            "kalman_ekf",
            "lkh3",
            "lns",
            "lyapunov_dpp",
            "mappo",
            "microfame",
            "nsga2",
            "nsga3",
            "pensieve",
            "ppo",
            "pso",
            "rpw",
            "rrt",
            "sa",
            "spea2",
            "ts",
            "vns",
            "whca_star"
          ]
        },
        "推荐理由": {
          "type": "string",
          "minLength": 20,
          "maxLength": 115
        }
      }
    },
    "feedback_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "action"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 2
        },
        "action": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "parameter_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge_offload_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "replanning_window_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cloud_update_period_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "urgent_priority_weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "privacy_filter": {
          "type": "boolean"
        },
        "fallback_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "parameter_rationale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge_offload_threshold": {
          "type": "string",
          "minLength": 20,
          "maxLength": 120
        },
        "replanning_window_sec": {
          "type": "string",
          "minLength": 20,
          "maxLength": 120
        },
        "cloud_update_period_min": {
          "type": "string",
          "minLength": 20,
          "maxLength": 120
        },
        "urgent_priority_weight": {
          "type": "string",
          "minLength": 20,
          "maxLength": 120
        },
        "privacy_filter": {
          "type": "string",
          "minLength": 20,
          "maxLength": 120
        },
        "fallback_threshold": {
          "type": "string",
          "minLength": 20,
          "maxLength": 120
        }
      }
    },
    "unavailable_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "端侧",
        "边缘",
        "云端",
        "处置类型"
      ],
      "properties": {
        "端侧": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "边缘": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "云端": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "处置类型": {
          "enum": [
            "reject",
            "defer_then_reject_on_timeout"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "协同策略": {
            "const": "defer_or_reject"
          }
        },
        "required": [
          "协同策略"
        ]
      },
      "then": {
        "required": [
          "无法执行原因"
        ],
        "properties": {
          "为什么不能固定部署": {
            "const": [
              "不适用：当前任务未接纳。"
            ]
          },
          "执行方案": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "当前处置",
              "恢复条件"
            ],
            "properties": {
              "当前处置": {
                "type": "string",
                "minLength": 5
              },
              "恢复条件": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          },
          "适合算法": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "强烈推荐",
              "推荐",
              "可用"
            ],
            "properties": {
              "强烈推荐": {
                "type": "array",
                "maxItems": 0
              },
              "推荐": {
                "type": "array",
                "maxItems": 0
              },
              "可用": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "最优算法": {
            "type": "null"
          },
          "超参数设定": {
            "maxProperties": 0
          },
          "参数依据": {
            "maxProperties": 0
          },
          "反馈调整建议": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/feedback_item"
            }
          },
          "推理": {
            "type": "string",
            "minLength": 30,
            "maxLength": 90
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "无法执行原因"
          ]
        },
        "properties": {
          "为什么不能固定部署": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 20
            }
          },
          "执行方案": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "总体执行位置",
              "端侧",
              "边缘",
              "云端",
              "网络"
            ],
            "properties": {
              "总体执行位置": {
                "type": "string",
                "minLength": 5
              },
              "端侧": {
                "type": "string",
                "minLength": 5
              },
              "边缘": {
                "type": "string",
                "minLength": 5
              },
              "云端": {
                "type": "string",
                "minLength": 5
              },
              "网络": {
                "type": "string",
                "minLength": 5
              }
            }
          },
          "适合算法": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "强烈推荐",
              "推荐",
              "可用"
            ],
            "properties": {
              "强烈推荐": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/candidate"
                }
              },
              "推荐": {
                "type": "array",
                "minItems": 0,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/candidate"
                }
              },
              "可用": {
                "type": "array",
                "minItems": 0,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/candidate"
                }
              }
            }
          },
          "最优算法": {
            "type": "string",
            "enum": [
              "abc",
              "aco",
              "admm",
              "agemoea2",
              "astar",
              "autoencoder_anomaly",
              "b&b",
              "bola",
              "cbs",
              "cp_sat",
              "cusum",
              "de",
              "dqn",
              "dynamic_batching",
              "edgent",
              "eecbs",
              "fedavg",
              "g&t",
              "ga",
              "ha",
              "ils",
              "isolation_forest",
              "kalman_ekf",
              "lkh3",
              "lns",
              "lyapunov_dpp",
              "mappo",
              "microfame",
              "nsga2",
              "nsga3",
              "pensieve",
              "ppo",
              "pso",
              "rpw",
              "rrt",
              "sa",
              "spea2",
              "ts",
              "vns",
              "whca_star"
            ]
          },
          "超参数设定": {
            "minProperties": 2,
            "maxProperties": 4
          },
          "参数依据": {
            "minProperties": 2,
            "maxProperties": 4
          },
          "反馈调整建议": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "$ref": "#/$defs/feedback_item"
            }
          },
          "推理": {
            "type": "string",
            "minLength": 60,
            "maxLength": 180
          }
        }
      }
    }
  ]
}
