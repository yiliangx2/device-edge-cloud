{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "algorithm_catalog_v1.schema.json",
  "title": "端边云算法目录 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "record_count",
    "decision_target_catalog_version",
    "source_file_sha256",
    "algorithms"
  ],
  "properties": {
    "catalog_version": {
      "const": "algorithm_catalog_v1"
    },
    "record_count": {
      "const": 40
    },
    "decision_target_catalog_version": {
      "const": "decision_target_catalog_v1"
    },
    "source_file_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "algorithms": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/algorithm"
      }
    }
  },
  "$defs": {
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "algorithm_name_zh",
        "algorithm_name_en",
        "abbreviation",
        "variants",
        "entry_kind",
        "algorithm_family",
        "description",
        "inherited_problem_types",
        "decision_target_fit",
        "usage_characteristics",
        "strengths",
        "limitations",
        "required_conditions",
        "key_hyperparameters",
        "evidence",
        "evidence_status",
        "provenance"
      ],
      "properties": {
        "algorithm_id": {
          "type": "string",
          "pattern": "^[a-z0-9_&]+$"
        },
        "algorithm_name_zh": {
          "type": "string",
          "minLength": 1
        },
        "algorithm_name_en": {
          "type": "string",
          "minLength": 1
        },
        "abbreviation": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "entry_kind": {
          "enum": [
            "algorithm",
            "solver",
            "system_policy"
          ]
        },
        "algorithm_family": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "inherited_problem_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "decision_target_fit": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "decision_role",
              "fit_level",
              "recommendation_reason",
              "required_conditions",
              "limitations"
            ],
            "properties": {
              "target_id": {
                "enum": [
                  "multi_agent_path_planning",
                  "multi_agent_coordination",
                  "production_task_scheduling",
                  "machine_resource_assignment",
                  "dynamic_rescheduling",
                  "offloading_placement",
                  "compute_resource_allocation",
                  "joint_offloading_resource_allocation",
                  "multi_edge_load_balancing",
                  "communication_data_control",
                  "inference_pipeline_scheduling",
                  "accelerator_batching_allocation",
                  "model_partition_offloading",
                  "online_anomaly_detection",
                  "digital_twin_model_sync",
                  "model_update_global_optimization",
                  "adaptive_bitrate_control",
                  "rendering_offloading_placement",
                  "multiuser_compute_bandwidth_allocation",
                  "stream_anomaly_detection",
                  "data_aggregation_transmission_control"
                ]
              },
              "decision_role": {
                "enum": [
                  "task_side",
                  "resource_side",
                  "communication_data_side",
                  "model_inference_side",
                  "joint"
                ]
              },
              "fit_level": {
                "enum": [
                  "recommended",
                  "strongly_recommended",
                  "usable"
                ]
              },
              "recommendation_reason": {
                "type": "string",
                "minLength": 10
              },
              "required_conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "usage_characteristics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "online_mode",
            "scale_range",
            "realtime_capability",
            "compute_cost",
            "solution_quality",
            "required_problem_structure"
          ],
          "properties": {
            "online_mode": {
              "enum": [
                "offline",
                "online",
                "both"
              ]
            },
            "scale_range": {
              "enum": [
                "small",
                "small_to_medium",
                "medium",
                "medium_to_large",
                "large"
              ]
            },
            "realtime_capability": {
              "enum": [
                "low",
                "medium",
                "high",
                "conditional"
              ]
            },
            "compute_cost": {
              "enum": [
                "low",
                "medium",
                "high",
                "very_high"
              ]
            },
            "solution_quality": {
              "type": "string",
              "minLength": 1
            },
            "required_problem_structure": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "key_hyperparameters": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url",
              "evidence_type"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "evidence_type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "evidence_status": {
          "enum": [
            "verified_primary_or_official",
            "inherited_with_source_not_reverified",
            "inherited_unverified"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source_file",
            "source_ids"
          ],
          "properties": {
            "status": {
              "enum": [
                "retained",
                "merged",
                "new"
              ]
            },
            "source_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
